name: 🔄 Auto Hello

on:
  workflow_dispatch:
    inputs:
      loop_count:
        description: 'Nilai loop awal (default 9999)'
        required: false
        default: '9999'
  workflow_run:
    workflows:
      - "🟢 phanu"
    types:
      - completed
  schedule:
    - cron: '*/10 * * * *'

permissions:
  actions: write

jobs:
  manual-start:
    if: github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    steps:
      - name: Mulai loop dengan phanu (next = khirap)
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          LOOP=${{ github.event.inputs.loop_count }}
          curl -X POST \
            -H "Authorization: token $GITHUB_TOKEN" \
            -H "Accept: application/vnd.github.v3+json" \
            https://api.github.com/repos/${{ github.repository }}/actions/workflows/phanu.yml/dispatches \
            -d "{\"ref\":\"main\",\"inputs\":{\"loop_count\":\"$LOOP\",\"next_phase\":\"khirap\"}}"

  auto-restart:
    if: github.event_name == 'workflow_run'
    runs-on: ubuntu-latest
    steps:
      - name: Cek apakah ada workflow lain yang sedang berjalan
        id: check
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          REPO="${{ github.repository }}"
          check_in_progress() {
            WF_FILE=$1
            RUNS=$(curl -s -H "Authorization: token $GITHUB_TOKEN" \
              "https://api.github.com/repos/$REPO/actions/workflows/$WF_FILE/runs?status=in_progress&per_page=1")
            TOTAL=$(echo "$RUNS" | jq '.total_count')
            [ "$TOTAL" -gt 0 ] && return 0 || return 1
          }
          if check_in_progress "khurap.yml" || check_in_progress "khirap.yml" || check_in_progress "phanu.yml"; then
            echo "idle=false" >> $GITHUB_OUTPUT
          else
            echo "idle=true" >> $GITHUB_OUTPUT
          fi
      - name: Restart via phanu
        if: steps.check.outputs.idle == 'true'
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          curl -X POST \
            -H "Authorization: token $GITHUB_TOKEN" \
            -H "Accept: application/vnd.github.v3+json" \
            https://api.github.com/repos/${{ github.repository }}/actions/workflows/phanu.yml/dispatches \
            -d '{"ref":"main","inputs":{"loop_count":"9999","next_phase":"khirap"}}'

  watchdog:
    if: github.event_name == 'schedule'
    runs-on: ubuntu-latest
    steps:
      - name: Cek apakah loop hidup
        id: check
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          REPO="${{ github.repository }}"
          check_in_progress() {
            WF_FILE=$1
            RUNS=$(curl -s -H "Authorization: token $GITHUB_TOKEN" \
              "https://api.github.com/repos/$REPO/actions/workflows/$WF_FILE/runs?status=in_progress&per_page=1")
            TOTAL=$(echo "$RUNS" | jq '.total_count')
            [ "$TOTAL" -gt 0 ] && return 0 || return 1
          }
          if check_in_progress "khurap.yml" || check_in_progress "khirap.yml" || check_in_progress "phanu.yml"; then
            echo "alive=true" >> $GITHUB_OUTPUT
          else
            echo "alive=false" >> $GITHUB_OUTPUT
          fi
      - name: Restart jika mati
        if: steps.check.outputs.alive == 'false'
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          curl -X POST \
            -H "Authorization: token $GITHUB_TOKEN" \
            -H "Accept: application/vnd.github.v3+json" \
            https://api.github.com/repos/${{ github.repository }}/actions/workflows/phanu.yml/dispatches \
            -d '{"ref":"main","inputs":{"loop_count":"9999","next_phase":"khirap"}}'